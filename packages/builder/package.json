{
  "name": "@formcraft/builder",
  "version": "0.0.0-prototype",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.d.ts",
      "default": "./dist/style.css"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build --config ../../vite.library.config.ts && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@radix-ui/react-dialog": "1.1.23",
    "lucide-react": "1.42.0",
    "zustand": "5.0.15",
    "@formcraft/core": "workspace:*",
    "@dnd-kit/collision": "0.5.0"
  }
}
