{
  "name": "formcraft-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:packages && vite --host 127.0.0.1",
    "build": "pnpm build:packages && tsc --noEmit && vite build",
    "test": "pnpm build:packages && vitest run",
    "build:packages": "pnpm --filter @formcraft/core build && pnpm --filter @formcraft/builder build && pnpm --filter @formcraft/renderer build",
    "test:consumer": "pnpm build:packages && node scripts/test-consumer.mjs"
  },
  "devDependencies": {
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "lucide-react": "1.42.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  }
}
